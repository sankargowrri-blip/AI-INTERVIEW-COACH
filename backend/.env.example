# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interview_coach

# Security
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Provider — set AI_PROVIDER to "gemini" or "openai"
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key
GOOGLE_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# CORS — set to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173

# Environment
ENV=development
PORT=8000
